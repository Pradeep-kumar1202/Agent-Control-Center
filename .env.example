# ── PR creation (routes/patches.ts → skills/githubPr.ts) ───────────────────
# Auth for direct pushes and PR creation in the canonical juspay repositories
# comes from `gh auth login` plus the user's Git credential helper (see README).
# No GitHub token or fork configuration is stored by the dashboard.
# Optional only when gitleaks is installed outside PATH:
# GITLEAKS_BIN=/opt/homebrew/bin/gitleaks

# ── Android preview (Part B: skills/previewManager.ts) ──────────────────────
# AVD to boot when starting an android-emulator preview. Must already exist
# under ~/.android/avd/. List with: $ANDROID_HOME/emulator/emulator -list-avds
PREVIEW_AVD=Pixel_9_Pro
# Desktop machines default to a visible Android Emulator window. Linux hosts
# without DISPLAY/WAYLAND_DISPLAY default to headless. Either can be forced:
# PREVIEW_EMU_HEADLESS=false
# Optional GPU override (`auto` for a window, `swiftshader_indirect` headless):
# PREVIEW_EMU_GPU=auto
# Emulator resource overrides. `hw.ramSize` in config.ini is flaky; CLI
# flags win every time. Drop these if the host is tight on memory.
PREVIEW_EMU_MEMORY_MB=6144
PREVIEW_EMU_CORES=4
