{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PR port triage result",
  "type": "object",
  "additionalProperties": false,
  "required": ["featureName", "changeKind", "portability", "reasons", "portableFiles", "skippedFiles"],
  "properties": {
    "featureName": { "type": "string", "minLength": 1 },
    "changeKind": { "enum": ["config", "component", "api", "bugfix", "refactor", "infra"] },
    "portability": { "enum": ["yes", "partial", "no"] },
    "reasons": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "portableFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "why"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    },
    "skippedFiles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "why"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "why": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
